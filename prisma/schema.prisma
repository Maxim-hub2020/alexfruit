generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  COURIER
  PICKER
}

enum ProductUnit {
  KG
  PIECE
  PACK
}

enum StockStatus {
  IN_STOCK
  LOW
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  PENDING_CONFIRMATION
  CONFIRMED
  ASSEMBLING
  ASSEMBLED
  HANDED_TO_COURIER
  COURIER_ON_THE_WAY
  DELIVERED
  CANCELLED
  DELIVERY_ISSUE
}

enum DeliveryTaskStatus {
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  ISSUE
  CANCELLED
}

enum ProblemType {
  CUSTOMER_UNREACHABLE
  CUSTOMER_ABSENT
  RESCHEDULE
  FAILED_DELIVERY
  OTHER
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_UPDATED
  ORDER_ASSEMBLED
  ORDER_HANDED_TO_COURIER
  COURIER_ON_THE_WAY
  COURIER_ARRIVING_SOON
  ORDER_DELIVERED
  ORDER_CANCELLED
  REPLACEMENT_REQUIRED
}

model User {
  id                String             @id @default(cuid())
  name              String
  phone             String?            @unique
  email             String?            @unique
  passwordHash      String
  role              Role               @default(CUSTOMER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customerProfile   CustomerProfile?
  courierProfile    Courier?
  addresses         Address[]
  orders            Order[]            @relation("CustomerOrders")
  assignedOrders    Order[]            @relation("CourierOrders")
  deliveryTasks     DeliveryTask[]     @relation("CourierTasks")
  courierLocation   CourierLocation?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  ownedSharedCarts  SharedCart[]       @relation("SharedCartOwner")
  sharedCartItems   SharedCartItem[]   @relation("SharedCartItemContributor")
}

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  defaultAddressId String?
  notes            String?
  bonusBalance     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress   Address? @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
}

model Address {
  id                String            @id @default(cuid())
  userId            String
  title             String
  city              String
  street            String
  house             String
  apartment         String?
  entrance          String?
  floor             String?
  comment           String?
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  isDefault         Boolean           @default(false)
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultForProfile CustomerProfile[] @relation("DefaultAddress")
  orders            Order[]

  @@index([userId])
  @@index([userId, isDeleted])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id               String           @id @default(cuid())
  categoryId       String
  name             String
  description      String?
  price            Decimal          @db.Decimal(10, 2)
  unit             ProductUnit
  imageUrl         String?
  isActive         Boolean          @default(true)
  isHit            Boolean          @default(false)
  isNew            Boolean          @default(false)
  isPromo          Boolean          @default(false)
  stockStatus      StockStatus      @default(IN_STOCK)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category         @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  sharedCartItems  SharedCartItem[]
  dailyInventories DailyInventory[]

  @@index([categoryId])
}

model DailyInventory {
  id               String   @id @default(cuid())
  productId        String
  date             DateTime @db.Date
  quantityStart    Decimal  @default(0) @db.Decimal(10, 2)
  quantityReserved Decimal  @default(0) @db.Decimal(10, 2)
  quantitySold     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@index([productId])
}

model SharedCart {
  id        String           @id @default(cuid())
  token     String           @unique
  ownerId   String
  title     String
  isActive  Boolean          @default(true)
  orderedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  owner     User             @relation("SharedCartOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items     SharedCartItem[]
  orders    Order[]

  @@index([ownerId, createdAt])
}

model SharedCartItem {
  id           String      @id @default(cuid())
  sharedCartId String
  productId    String
  addedById    String
  productName  String
  price        Decimal     @db.Decimal(10, 2)
  unit         ProductUnit
  quantity     Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sharedCart   SharedCart  @relation(fields: [sharedCartId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id])
  addedBy      User        @relation("SharedCartItemContributor", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([sharedCartId, productId, addedById])
  @@index([sharedCartId, createdAt])
  @@index([addedById])
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique
  userId             String
  addressId          String
  sharedCartId       String?
  sharedCartTitle    String?
  deliveryDate       DateTime         @db.Date
  deliveryTimeSlotId String
  status             OrderStatus      @default(NEW)
  preliminaryTotal   Decimal          @db.Decimal(10, 2)
  finalTotal         Decimal?         @db.Decimal(10, 2)
  needsLift          Boolean          @default(false)
  liftFee            Decimal          @default(0) @db.Decimal(10, 2)
  customerComment    String?
  adminComment       String?
  courierId          String?
  editableUntil      DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Cascade)
  address            Address          @relation(fields: [addressId], references: [id])
  sharedCart         SharedCart?      @relation(fields: [sharedCartId], references: [id], onDelete: SetNull)
  deliveryTimeSlot   DeliveryTimeSlot @relation(fields: [deliveryTimeSlotId], references: [id])
  courier            User?            @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  deliveryTask       DeliveryTask?
  notifications      Notification[]

  @@index([userId, deliveryDate])
  @@index([courierId])
  @@index([sharedCartId])
}

model OrderItem {
  id               String      @id @default(cuid())
  orderId          String
  productId        String?
  productName      String
  price            Decimal     @db.Decimal(10, 2)
  unit             ProductUnit
  orderedQuantity  Decimal     @db.Decimal(10, 2)
  actualQuantity   Decimal?    @db.Decimal(10, 2)
  reservedQuantity Decimal     @default(0) @db.Decimal(10, 2)
  isPreorder       Boolean     @default(false)
  preliminarySum   Decimal     @db.Decimal(10, 2)
  finalSum         Decimal?    @db.Decimal(10, 2)
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model DeliveryTimeSlot {
  id        String  @id @default(cuid())
  title     String  @unique
  startTime String
  endTime   String
  maxOrders Int
  isActive  Boolean @default(true)
  orders    Order[]
}

model Courier {
  id       String  @id @default(cuid())
  userId   String  @unique
  name     String
  phone    String?
  isActive Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryTask {
  id                         String             @id @default(cuid())
  orderId                    String             @unique
  courierId                  String
  status                     DeliveryTaskStatus @default(ASSIGNED)
  routeOrder                 Int?
  estimatedArrivalAt         DateTime?
  etaMinutes                 Int?
  etaUpdatedAt               DateTime?
  routeStartedAt             DateTime?
  routeEtaNotificationSentAt DateTime?
  deliveredAt                DateTime?
  arrivalNotificationSent    Boolean            @default(false)
  problemType                ProblemType?
  problemComment             String?
  order                      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier                    User               @relation("CourierTasks", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, status])
}

model CourierLocation {
  id        String   @id @default(cuid())
  courierId String   @unique
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  accuracy  Decimal? @db.Decimal(8, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courier   User     @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  orderId   String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
