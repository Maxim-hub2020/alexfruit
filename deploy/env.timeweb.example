# Copy this file to .env on the Timeweb server and fill real values.
# Do not commit the real .env file to GitHub.

APP_DOMAIN=alexfruit.example.com
APP_URL=https://alexfruit.example.com
NODE_ENV=production
ACME_EMAIL=admin@alexfruit.example.com

POSTGRES_DB=alexfrut
POSTGRES_USER=alexfrut
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql://alexfrut:change-this-postgres-password@db:5432/alexfrut
DATABASE_POOL_MAX=10

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

YANDEX_MAPS_API_KEY=
DADATA_API_KEY=

NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://alexfruit.example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_BOT_DEEP_LINK_BASE=
MAX_BOT_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=

STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=

LABEL_FONT_PATH=
LABEL_BOLD_FONT_PATH=

DEFAULT_ADMIN_EMAIL=admin@alexfrut.local
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_COURIER_EMAIL=courier@alexfrut.local
DEFAULT_COURIER_PASSWORD=change-this-courier-password
DEFAULT_CUSTOMER_EMAIL=customer@alexfrut.local
DEFAULT_CUSTOMER_PASSWORD=change-this-customer-password

RATE_LIMIT_AUTH_MAX=8
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_ORDERS_MAX=25
RATE_LIMIT_ORDERS_WINDOW_MS=60000
RATE_LIMIT_API_MAX=180
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_STAFF_MAX=120
RATE_LIMIT_STAFF_WINDOW_MS=60000
RATE_LIMIT_PAGE_MAX=240
RATE_LIMIT_PAGE_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=5000
